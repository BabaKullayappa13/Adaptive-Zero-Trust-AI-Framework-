# PostgreSQL Configuration
# Set this only in the backend/Render environment. Never expose it to the browser.
DATABASE_URL=
# Optional direct connection for migrations or admin tooling; keep server-side only.
DATABASE_URL_UNPOOLED=

# Frontend Configuration
# Used by the Next.js server-side rewrite; do not prefix with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Zero Trust AI Framework

# Neon Auth Configuration
# Hosted Neon Auth base URL and its public signing-key endpoint.
NEON_AUTH_BASE_URL=https://your-neon-auth-host/neondb/auth
NEON_AUTH_JWKS_URL=https://your-neon-auth-host/neondb/auth/.well-known/jwks.json
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-host/neondb/auth

# Backend Configuration
FASTAPI_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=15
MFA_ISSUER=Neon Auth
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
ZERO_TRUST_POLICY_VERSION=1.0
MODEL_PATH=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# Backend-only SMTP configuration. Required for password-reset delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=verified-sender@example.com
SMTP_FROM_NAME=Adaptive Zero Trust AI
SMTP_USE_SSL=false
FRONTEND_URL=http://localhost:3000

# Admin configuration (backend/Render only)
ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
ADMIN_USER_IDS=admin-user-id-1,admin-user-id-2

# Performance Monitoring
ENABLE_PERFORMANCE_TRACKING=true

# Logging
LOG_LEVEL=INFO
