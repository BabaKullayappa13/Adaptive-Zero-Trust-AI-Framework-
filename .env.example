# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/zero_trust_ai
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/zero_trust_ai

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Zero Trust AI Framework

# Backend Configuration
FASTAPI_ENV=development
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
MFA_ISSUER=ZeroTrustAI

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
