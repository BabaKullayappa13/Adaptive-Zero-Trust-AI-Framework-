# ============================================================================
# Adaptive Zero Trust-AI Framework - Environment Variables
# ----------------------------------------------------------------------------
# Copy to .env.local (dev) or set in Vercel Project Settings -> Environment
# Variables (production). Every variable below is referenced by real code.
# Never commit real secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (backend/main.py + all backend services) - REQUIRED
# Provided automatically by the Neon integration on Vercel.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Backend auth / JWT (backend/main.py) - REQUIRED
# SECRET_KEY signs access + refresh JWTs. Generate with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret

# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Issuer name shown in Google Authenticator / TOTP apps (default: Zero Trust AI)
MFA_ISSUER=Zero Trust AI

# Comma-separated origins allowed to call the backend (CORS).
# In production set this to your real domain, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated user UUIDs granted the admin role (backend/main.py admin guard).
# Empty means no one is an admin, so every /api/admin/* route returns 403.
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# ML models (backend/ml_model_training.py) - OPTIONAL
# Directory for trained joblib artifacts (default: /tmp/models).
# Serverless filesystems are read-only outside /tmp, and /tmp does not persist
# between invocations, so point this at durable storage for real training runs.
# ---------------------------------------------------------------------------
MODEL_DIR=/tmp/models

# ---------------------------------------------------------------------------
# Backend OpenAPI documentation URLs (backend/api_documentation.py) - OPTIONAL
# Only affects the URLs listed in the generated OpenAPI/Swagger spec.
# API_PUBLIC_URL is omitted from the spec when left empty.
# ---------------------------------------------------------------------------
API_DEV_URL=http://localhost:8000
API_PUBLIC_URL=

# ---------------------------------------------------------------------------
# NOTE: there is deliberately no BACKEND_API_URL / NEXT_PUBLIC_API_URL here.
# The frontend calls relative `/api/*` paths, and Vercel routes those to the
# Python service via `experimentalServices` in the root vercel.json - in both
# `vercel dev` and production. No backend origin needs to be configured.
# ---------------------------------------------------------------------------
