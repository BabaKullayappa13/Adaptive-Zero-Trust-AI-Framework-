# ==============================================================================
# Adaptive Zero Trust-AI Framework - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon PostgreSQL Database Configuration (Backend / Server-side only)
# ------------------------------------------------------------------------------
# Primary pooled connection string from Neon Console (with sslmode=require)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional direct (unpooled) connection for migrations and admin tools
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require

# SQLite fallback path when PostgreSQL is not configured (development only)
SQLITE_DB_PATH=backend/zero_trust.db
DB_POOL_MAX_SIZE=10

# ------------------------------------------------------------------------------
# 2. Neon Auth & JWKS Configuration
# ------------------------------------------------------------------------------
# Neon Auth base service URL
NEON_AUTH_BASE_URL=https://your-neon-auth-host.neon.tech/neondb/auth
NEON_AUTH_URL=https://your-neon-auth-host.neon.tech/neondb/auth

# JWKS public key rotation endpoint for RS256 token signature verification
NEON_AUTH_JWKS_URL=https://your-neon-auth-host.neon.tech/neondb/auth/.well-known/jwks.json

# Expected JWT claims (leave empty if not enforced by provider)
NEON_AUTH_ISSUER=https://your-neon-auth-host.neon.tech/neondb/auth
NEON_AUTH_AUDIENCE=

# Public variable for frontend Next.js client
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-host.neon.tech/neondb/auth

# Optional Neon Serverless Data API SQL endpoint
NEON_DATA_API_URL=https://your-neon-host.neon.tech/neondb/sql

# ------------------------------------------------------------------------------
# 3. Backend Core & Security Configuration
# ------------------------------------------------------------------------------
FASTAPI_ENV=development
SECRET_KEY=replace-with-a-secure-random-256-bit-key-for-session-signing
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=Adaptive Zero Trust AI

# Zero Trust Adaptive Risk Thresholds
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
ZERO_TRUST_POLICY_VERSION=2.0

# Path to trained model artifacts
MODEL_DIR=backend/models
MODEL_PATH=backend/models/best_model.joblib

# ------------------------------------------------------------------------------
# 4. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Adaptive Zero Trust AI Framework
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. Administrative & Session Secrets
# ------------------------------------------------------------------------------
ADMIN_ACCESS_KEY=
ADMIN_BOOTSTRAP_SECRET=replace-with-admin-bootstrap-secret
ADMIN_USER_IDS=admin-user-id-1,admin-user-id-2
ADMIN_SESSION_SECRET=replace-with-secure-admin-session-signing-secret

# ------------------------------------------------------------------------------
# 6. SMTP Email Verification & Recovery (Optional - fallback to demo OTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=security@zerotrust.ai
SMTP_FROM_NAME=Adaptive Zero Trust Security
SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# 7. Telemetry & Performance Monitoring
# ------------------------------------------------------------------------------
ENABLE_PERFORMANCE_TRACKING=true
LOG_LEVEL=INFO
