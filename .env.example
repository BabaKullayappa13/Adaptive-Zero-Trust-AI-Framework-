# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/zero_trust_ai
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/zero_trust_ai

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Zero Trust AI Framework

# Backend Configuration
FASTAPI_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=ZeroTrustAI

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# Admin Configuration (comma-separated user IDs)
ADMIN_USER_IDS=admin-user-id-1,admin-user-id-2

# Performance Monitoring
ENABLE_PERFORMANCE_TRACKING=true

# Logging
LOG_LEVEL=INFO
