{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/.next" }
    }
  ],
  "env": {
    "DATABASE_URL": "@neon_database_url",
    "JWT_SECRET": "@jwt_secret",
    "API_URL": "http://localhost:8000"
  },
  "experimentalServices": {
    "backend": {
      "entrypoint": "backend/main.py",
      "routePrefix": "/api"
    }
  }
}
